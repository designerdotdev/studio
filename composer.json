{
    "name": "designer/studio",
    "description": "A visual component builder/editor for Laravel applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tony Lea",
            "email": "tony@devdojo.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "symfony/yaml": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Designer\\Studio\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Designer\\Studio\\StudioServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
