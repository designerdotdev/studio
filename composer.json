{
    "name": "designer/studio",
    "description": "A visual component builder/editor for Laravel applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Designer Dev",
            "homepage": "https://designer.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "livewire/livewire": "^3.0",
        "filament/forms": "^3.2",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "katanaui/katana": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Designer\\Studio\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Designer\\Studio\\StudioServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
